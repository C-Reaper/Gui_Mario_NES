# === Makefile.web ===

CC = emcc
WARNINGS = -Werror
CFLAGS = -O3 -msimd128 -mavx2 -std=gnu17 -pthread $(WARNINGS)
INCLUDES = -Isrc -D_WEB -sINITIAL_MEMORY=338165760
LDFLAGS = -pthread -sPROXY_TO_PTHREAD -sPROXY_POSIX_SOCKETS -sPTHREAD_POOL_SIZE=2 -s USE_SDL=0 -lwebsocket.js --preload-file assets/
SRC_DIR = ./src
BUILD_DIR = ./build
TARGET = $(BUILD_DIR)/index.html

SRCS = $(wildcard $(SRC_DIR)/*.c)
OBJS = $(patsubst $(SRC_DIR)/%.c, $(BUILD_DIR)/%.o, $(SRCS))
POSIX_PROXY = $(BUILD_DIR)/websocket_to_posix_proxy/websocket_to_posix_proxy

all: $(BUILD_DIR) $(TARGET)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(TARGET): $(SRCS) Makefile.web force
	$(CC) $(CFLAGS) $(INCLUDES) $(SRCS) -o $(TARGET) $(LDFLAGS)

$(POSIX_PROXY): | $(BUILD_DIR)
	cmake -S "$$(em-config EMSCRIPTEN_ROOT)/tools/websocket_to_posix_proxy" -B "$(dir $(POSIX_PROXY))"
	cmake --build "$(dir $(POSIX_PROXY))"

exe: check-ports $(TARGET) $(POSIX_PROXY)
	@$(POSIX_PROXY) 8083 & \
	proxy_pid=$$!; \
	trap 'kill $$proxy_pid 2>/dev/null || true' EXIT INT TERM; \
	echo "Open http://localhost:8082 (use localhost for WebAssembly threads)"; \
	emrun --no_browser --hostname localhost --port 8082 $(BUILD_DIR)

check-ports:
	@python3 -c 'import socket,sys; ports=(("127.0.0.1",8082,"web server"),("0.0.0.0",8083,"POSIX proxy")); \
[(lambda s,h,p,n: (s.bind((h,p)),s.close()))(socket.socket(),host,port,name) for host,port,name in ports]' 2>/dev/null \
	|| { echo "A required port (8082 or 8083) is already in use; stop the existing WebAssembly run and retry." >&2; exit 1; }

clean:
	rm -rf $(BUILD_DIR)/*

do:
	@$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) check-ports
	@$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) clean
	@$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) all
	@$(MAKE) --no-print-directory -f $(firstword $(MAKEFILE_LIST)) exe

.PHONY: all exe clean do force check-ports

# === Makefile.web ===

force: