# === Makefile.wine ===

CC = x86_64-w64-mingw32-gcc
WARNINGS = -Werror
CFLAGS = -O3 -mavx2 -std=gnu17 $(WARNINGS)
INCLUDES = -Isrc -I$(HOME)/bin/mpg123-win64/include -D_WINE
LDFLAGS = -lm -luser32 -lgdi32 -lwinmm -lxinput9_1_0 -lole32 -loleaut32 -lwindowscodecs -lmfplat -lmf -lmfreadwrite -lmfuuid -lws2_32 $(HOME)/bin/mpg123-win64/lib/libmpg123.a -lshlwapi
SRC_DIR = ./src
BUILD_DIR = ./build
TARGET = $(BUILD_DIR)/Main.exe

SRCS = $(wildcard $(SRC_DIR)/*.c)
OBJS = $(patsubst $(SRC_DIR)/%.c, $(BUILD_DIR)/%.o, $(SRCS))

all: $(BUILD_DIR) $(TARGET)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(TARGET): $(SRCS)
	$(CC) $(CFLAGS) $(INCLUDES) $(SRCS) -o $(TARGET) $(LDFLAGS)

alldebug: 
	$(CC) -g $(CFLAGS) $(INCLUDES) $(SRC_DIR)/Main.c -o $(TARGET) $(LDFLAGS) 

debug:
	WINEPREFIX=~/wine64 WINEARCH=win64 winedbg $(TARGET)

exe: $(TARGET)
	WINEPREFIX=~/wine64 WINEARCH=win64 wine $(TARGET)

clean:
	rm -f $(BUILD_DIR)/*

dg: clean alldebug debug

do: clean all exe

# === Makefile.wine ===